# Copy this file to .env for local development, and enter the same two
# values as Environment Variables in Vercel when you deploy.
#
# Both of these are PUBLIC values — safe to expose in browser code. They are
# NOT secrets. Real protection comes from Supabase's Row Level Security and
# the PIN-validating RPC functions, not from hiding these values.

VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_public_anon_key
